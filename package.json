{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/parseYml.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "prebuild": "node scripts/parseYml.ts",
    "preview": "vite preview",
    "build-only": "vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.ts",
    "build:data": "node scripts/parseYml.ts",
    "parse:yml": "node scripts/parseYml.ts",
    "type-check": "vue-tsc --build",
    "test": "node --test tests/*.test.ts",
    "lint:check": "oxlint . && eslint . --no-cache",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "sass-embedded": "^1.107.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
